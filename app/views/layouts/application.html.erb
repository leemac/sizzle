<!DOCTYPE html>
<html lang="en" data-theme="<%= appearance.theme.id %>" data-mode="<%= appearance.effective_mode %>">
  <head>
    <%= inertia_meta_tags(default_title: content_for(:title) || "Sizzle") %>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="application-name" content="Sizzle">
    <meta name="apple-mobile-web-app-title" content="Sizzle">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="<%= appearance.effective_mode == "dark" ? "black" : "default" %>">
    <meta name="color-scheme" content="<%= appearance.color_scheme %>">
    <% if appearance.effective_mode == "auto" %>
      <meta name="theme-color" content="<%= appearance.theme_colors[:light] %>" media="(prefers-color-scheme: light)">
      <meta name="theme-color" content="<%= appearance.theme_colors[:dark] %>" media="(prefers-color-scheme: dark)">
    <% else %>
      <meta name="theme-color" content="<%= appearance.theme_colors[:light] %>">
    <% end %>
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_stylesheet_tag "application" %>
    <%= theme_style_tag %>
    <%= vite_react_refresh_tag %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag "inertia.tsx" %>
    <%= inertia_ssr_head %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
