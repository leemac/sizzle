#!/usr/bin/env sh
# Look for secrets (API keys, tokens, private keys) in git history with gitleaks.
#
#   bin/secret-scan                          every commit on this branch (bin/ci, GitHub Actions)
#   bin/secret-scan --pre-commit --staged    only what you're about to commit (.githooks/pre-commit)
#
# Committed a secret by mistake? Revoke it first. Once pushed, deleting it from history isn't enough.

set -eu
cd "$(dirname "$0")/.."

# Install the pinned gitleaks up front, so a failed download isn't mistaken for a failed self-test.
bin/gitleaks version > /dev/null

# A full scan first proves the rules still fire, so a broken config can't pass as "no leaks found".
# The planted secrets are random and live in a temp directory that's removed straight away.
if [ $# -eq 0 ]
then
  canary=$(mktemp -d)
  printf 'ANTHROPIC_API_KEY=sk-ant-api03-%sAA\n' "$(od -An -N47 -tx1 /dev/urandom | tr -d ' \n' | cut -c1-93)" > "$canary/anthropic.env"
  printf 'ENV["SIZZLE_API_TOKEN"] = "%s"\n' "$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')" > "$canary/token.rb"
  for planted in "$canary"/*
  do
    if ! bin/gitleaks dir --config .gitleaks.toml --no-banner --log-level=error --exit-code=0 --report-format=json --report-path=- "$planted" | grep -q '"RuleID"'
    then
      rm -rf "$canary"
      echo "Secret scan self-test failed: gitleaks didn't flag a planted secret ($(basename "$planted")). Check .gitleaks.toml." >&2
      exit 1
    fi
  done
  rm -rf "$canary"
fi

if ! bin/gitleaks git --config .gitleaks.toml --redact --verbose --no-banner "$@"
then
  echo "" >&2
  echo "Found what looks like a secret (shown redacted above). Move it to .env and read it through lib/sizzle.rb." >&2
  echo "If it's a false positive, add a 'gitleaks:allow' comment to that line. If it was ever pushed, revoke it." >&2
  exit 1
fi
