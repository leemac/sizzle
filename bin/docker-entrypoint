#!/bin/bash -e

# Generate a secret key on first boot and keep it in the storage volume, so
# self-hosters never have to create one by hand. Set SECRET_KEY_BASE to override.
if [ -z "${SECRET_KEY_BASE}" ]; then
  key_file="/rails/storage/.secret_key_base"
  if [ ! -s "$key_file" ]; then
    (umask 077 && head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n' > "$key_file")
  fi
  export SECRET_KEY_BASE="$(cat "$key_file")"
fi

if [ -z "${ANTHROPIC_API_KEY}" ]; then
  echo "Claude is not configured. Structured recipe imports and manual recipes work without an API key."
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
