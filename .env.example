# Copy to .env and fill in. Never commit .env.

# Optional AI extraction for pages without usable recipe data and pasted text.
# Manual recipes and structured recipe imports work without a key.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: which Claude model cleans up recipes, and how hard it thinks
# (low | medium | high). Lower effort is cheaper and faster.
# SIZZLE_CLAUDE_MODEL=claude-opus-5-5
# SIZZLE_CLAUDE_EFFORT=medium

# Recommended: require `Authorization: Bearer <token>` on the share API.
# Generate one with: openssl rand -hex 32
SIZZLE_API_TOKEN=

# Hostnames you'll use to reach Sizzle, comma-separated. IP addresses, bare
# hostnames and *.local / *.lan / *.home.arpa / *.ts.net work without this.
# SIZZLE_HOSTS=recipes.example.com

# Set both when Sizzle sits behind an HTTPS reverse proxy.
# SIZZLE_ASSUME_SSL=true
# SIZZLE_FORCE_SSL=true

# Which release docker compose runs. latest follows every release; pin a version
# (e.g. 0.0.1) to upgrade only when you change it. See docs/self-hosting.md.
# SIZZLE_VERSION=latest

# Host port for docker compose.
# SIZZLE_PORT=3000

# Allow imports from private network addresses (e.g. a recipe site on your LAN).
# Off by default: anyone who can submit an import could use it to probe your network.
# SIZZLE_ALLOW_PRIVATE_NETWORK_FETCH=false

# Turn on the theme editor, so people can make, change and delete themes everyone shares.
# Off by default: Sizzle has no login, so anyone who can reach it could change or delete
# someone else's theme. Picking a built-in theme works either way.
# SIZZLE_THEME_EDITOR=false
